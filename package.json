{
  "name": "photo-cards",
  "version": "0.1.0",
  "private": true,
  "description": "Create, customize, and collect personalized photo cards.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"pnpm --filter @photo-cards/server dev\" \"pnpm --filter @photo-cards/client dev\"",
    "build": "pnpm --filter @photo-cards/server build && pnpm --filter @photo-cards/client build",
    "start": "pnpm --filter @photo-cards/server start",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @photo-cards/server typecheck && pnpm --filter @photo-cards/client typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
